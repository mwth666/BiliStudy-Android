<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">
            <View android:layout_width="12dp" android:layout_height="12dp"
                android:background="@color/primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="  B站学习陪伴" android:textSize="20sp" android:textStyle="bold"
                android:textColor="@color/text" />
            <TextView android:id="@+id/streakTop" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginLeft="12dp"
                android:text="🔥 0 天" android:textSize="14sp" android:textColor="#FFE8734A" />
        </LinearLayout>

        <!-- 采集状态 -->
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/muted" android:layout_marginBottom="14dp" />

        <!-- 三个核心数字 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">

            <LinearLayout android:layout_width="0dp" android:layout_weight="1.3"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_card" android:gravity="center"
                android:padding="14dp" android:layout_marginRight="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="今日观看" android:textSize="12sp" android:textColor="@color/muted" />
                <TextView android:id="@+id/todayVal" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0分钟"
                    android:textSize="20sp" android:textStyle="bold" android:textColor="@color/primary" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_card" android:gravity="center"
                android:padding="14dp" android:layout_marginLeft="3dp" android:layout_marginRight="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="本周" android:textSize="12sp" android:textColor="@color/muted" />
                <TextView android:id="@+id/weekVal" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/text" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/bg_card" android:gravity="center"
                android:padding="14dp" android:layout_marginLeft="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="本月" android:textSize="12sp" android:textColor="@color/muted" />
                <TextView android:id="@+id/monthVal" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/text" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="按视频内容进度累计 · 3 倍速看 1 分钟 = 记 3 分钟"
            android:textSize="11sp" android:textColor="@color/muted"
            android:gravity="center" android:layout_marginBottom="18dp" />

        <!-- 权限向导 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="开启通知读取权（必须）" android:textSize="14sp"
                android:textStyle="bold" android:textColor="@color/text" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="用来读取 B 站的播放位置、时长和倍速。不读聊天、不读短信内容。"
                android:textSize="12sp" android:textColor="@color/muted"
                android:layout_marginTop="4dp" />
            <Button android:id="@+id/btnNotif" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="去开启通知读取权"
                android:background="@drawable/bg_btn_primary" android:textColor="#FFFFFFFF"
                android:textSize="14sp" android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 课程进度 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="课程进度" android:textSize="14sp" android:textStyle="bold"
                android:textColor="@color/text" />
            <TextView android:id="@+id/courses" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="还没有观看记录"
                android:textSize="12sp" android:textColor="@color/muted"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 完整统计入口 -->
        <Button android:id="@+id/btnStats" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="查看完整统计 →"
            android:background="@drawable/bg_btn_primary" android:textColor="#FFFFFFFF"
            android:textSize="15sp" android:layout_marginBottom="12dp"
            android:padding="12dp" />

        <Button android:id="@+id/btnClear" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="清除全部数据"
            android:background="@drawable/bg_card" android:textColor="#FFD9534F"
            android:textSize="13sp" android:layout_marginTop="4dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="数据只存在手机本地，不联网、不上传、不用登录。"
            android:textSize="11sp" android:textColor="@color/muted"
            android:gravity="center" android:layout_marginTop="14dp" />

    </LinearLayout>
</ScrollView>
